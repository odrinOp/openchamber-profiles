{
  "name": "openchamber-profiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:page",
    "build:page": "openchamber-guest-bundle page/main.ts page/main.js",
    "check": "openchamber-guest-check",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "profiles",
    "name": "Profiles",
    "icon": "user-settings",
    "contributes": {
      "panel": {
        "entry": "page/index.html"
      },
      "capabilities": [
        "sessions"
      ],
      "page": true
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun": "latest",
    "typescript": "^5.6.0"
  }
}
